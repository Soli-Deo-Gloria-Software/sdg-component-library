{
  "name": "root",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:components": "npm run build -w @soli-deo-gloria-software/sdg-components",
    "build:angular": "npm run build:components && npm run build -w angular-workspace -- sdg-components-angular",
    "publish:components": "bash scripts/publish-components.sh",
    "publish:angular": "bash scripts/publish-angular.sh",
    "publish:all": "bash scripts/publish-all.sh"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "lerna": "^9.0.7",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "nx": false,
    "@parcel/watcher@2.5.6": true,
    "esbuild@0.28.1": true,
    "esbuild@0.27.7": true,
    "lmdb@3.5.1": true,
    "msgpackr-extract@3.0.4": true
  }
}
