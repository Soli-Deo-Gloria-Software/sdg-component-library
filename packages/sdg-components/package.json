{
  "name": "@soli-deo-gloria-software/sdg-components",
  "version": "0.0.6",
  "description": "Soli Deo Gloria Software Component Library",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/sdg-components/sdg-components.esm.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/sdg-components/sdg-components.esm.js",
      "require": "./dist/sdg-components/sdg-components.cjs.js"
    },
    "./bible-reference-picker": {
      "import": "./dist/components/bible-reference-picker.js",
      "types": "./dist/components/bible-reference-picker.d.ts"
    },
    "./loader": {
      "types": "./loader/index.d.ts",
      "import": "./loader/index.js",
      "require": "./loader/index.cjs.js"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Soli-Deo-Gloria-Software/sdg-component-library.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "version": "node ../../scripts/sync-angular-version.mjs",
    "prepublishOnly": "npm run build",
    "storybook": "npm run build && storybook dev -p 6006",
    "build-storybook": "npm run build && storybook build"
  },
  "devDependencies": {
    "@stencil/angular-output-target": "^1.4.1",
    "@stencil/core": "^4.44.2",
    "@stencil/vitest": "^1.8.3",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/web-components-vite": "^10.6.0",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "lit": "^3.3.3",
    "playwright": "^1.63.0",
    "storybook": "^10.6.0",
    "vitest": "^4.0.0"
  },
  "license": "MIT",
  "dependencies": {
    "@soli-deo-gloria-software/bible-books": "^0.9.5",
    "@soli-deo-gloria-software/bible-reference-finder": "^0.9.18"
  }
}
